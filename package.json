{
  "name": "@kawapress/monorepo",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/ensure-git-history.mjs && pnpm --dir docs build",
    "dev": "pnpm --dir docs dev",
    "preview": "pnpm --dir docs preview",
    "lint": "eslint . --cache",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @kawapress/e2e test",
    "bench": "pnpm --filter @kawapress/bench bench",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "release:prepare": "node scripts/release.mjs --prepare",
    "release:trust": "node scripts/trust-publishers.mjs",
    "release:lock": "node scripts/publishing-access.mjs"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "@kawapress/plugin-mathjax": "workspace:*",
    "@kawapress/plugin-shiki": "workspace:*",
    "@types/node": "catalog:dev",
    "@vitejs/plugin-vue": "catalog:node",
    "eslint": "catalog:dev",
    "jiti": "catalog:node",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev",
    "vue-tsc": "catalog:dev"
  }
}
