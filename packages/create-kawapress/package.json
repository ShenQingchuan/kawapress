{
  "name": "create-kawapress",
  "type": "module",
  "version": "0.2.0",
  "description": "Create a new KawaPress site",
  "license": "MIT",
  "homepage": "https://kawapress.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kawapress/kawapress.git",
    "directory": "packages/create-kawapress"
  },
  "bugs": {
    "url": "https://github.com/kawapress/kawapress/issues"
  },
  "keywords": [
    "create",
    "documentation",
    "scaffold",
    "ssg",
    "vue"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "create-kawapress": "./bin/create-kawapress.mjs"
  },
  "files": [
    "bin",
    "src/**/!(*.test.*)",
    "templates"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "kawapressVersion": "0.2.0",
  "dependencies": {
    "@clack/prompts": "catalog:node",
    "citty": "catalog:node",
    "jiti": "catalog:node"
  }
}
