    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "kawapress": "workspace:^"
  },
  "dependencies": {
    "consola": "catalog:node"
  },
  "devDependencies": {
    "happy-dom": "catalog:dev",
    "kawapress": "workspace:*",
    "typescript": "catalog:dev",
    "vite": "catalog:node",
    "vue": "catalog:frontend"
  }
