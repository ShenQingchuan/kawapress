{
  "name": "@kawapress/plugin-last-updated",
  "type": "module",
  "version": "0.2.0",
  "description": "Last updated time and edit link for every KawaPress page",
  "license": "MIT",
  "homepage": "https://kawapress.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kawapress/kawapress.git",
    "directory": "packages/plugin-last-updated"
  },
  "bugs": {
    "url": "https://github.com/kawapress/kawapress/issues"
  },
  "exports": {
    ".": {
