{
  "name": "@kawapress/plugin-image-zoom",
  "type": "module",
  "version": "0.2.1",
  "description": "Click-to-zoom images for KawaPress Markdown content",
  "license": "MIT",
  "homepage": "https://kawapress.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kawapress/kawapress.git",
    "directory": "packages/plugin-image-zoom"
  },
  "bugs": {
    "url": "https://github.com/kawapress/kawapress/issues"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
