    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "kawapress": "workspace:^"
  },
  "devDependencies": {
    "happy-dom": "catalog:dev",
    "markdown-exit": "catalog:markdown",
    "vite": "catalog:node"
  }
