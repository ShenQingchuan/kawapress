{
  "name": "kawapress",
  "type": "module",
  "version": "0.0.1-beta.1",
  "description": "A Vue-centric static site generator",
  "license": "MIT",
  "homepage": "https://shenqingchuan.github.io/kawapress/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShenQingchuan/kawapress.git",
    "directory": "packages/kawapress"
  },
  "bugs": {
    "url": "https://github.com/ShenQingchuan/kawapress/issues"
  },
  "keywords": [
    "documentation",
    "markdown",
    "ssg",
    "vite",
    "vue"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./cli": {
      "types": "./src/cli.ts",
      "import": "./src/cli.ts",
      "default": "./src/cli.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "import": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./nagi": {
      "types": "./src/nagi.ts",
      "import": "./src/nagi.ts",
      "default": "./src/nagi.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "kawapress": "./bin/kawapress.mjs"
  },
  "files": [
    "bin",
    "src"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@kawapress/preset-nagi": "workspace:*",
    "@mdit-vue/plugin-component": "catalog:markdown",
    "@mdit-vue/plugin-frontmatter": "catalog:markdown",
    "@mdit-vue/plugin-headers": "catalog:markdown",
    "@mdit-vue/plugin-sfc": "catalog:markdown",
    "@mdit/plugin-attrs": "catalog:markdown",
    "@unhead/vue": "catalog:frontend",
    "@vitejs/plugin-vue": "catalog:node",
    "@vue/server-renderer": "catalog:frontend",
    "citty": "catalog:node",
    "consola": "catalog:node",
    "gray-matter": "catalog:markdown",
    "jiti": "catalog:node",
    "markdown-exit": "catalog:markdown",
    "markdown-it-anchor": "catalog:markdown",
    "sirv": "catalog:node",
    "tinyglobby": "catalog:node",
    "vite": "catalog:node",
    "vue": "catalog:frontend",
    "vue-router": "catalog:frontend"
  }
}
