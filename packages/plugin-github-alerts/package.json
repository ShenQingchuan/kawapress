{
  "name": "@kawapress/plugin-github-alerts",
  "type": "module",
  "version": "0.3.0",
  "description": "GitHub-style Markdown alerts for KawaPress",
  "license": "MIT",
  "homepage": "https://kawapress.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kawapress/kawapress.git",
    "directory": "packages/plugin-github-alerts"
  },
  "bugs": {
    "url": "https://github.com/kawapress/kawapress/issues"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./runtime-plugin": {
      "types": "./src/runtime-plugin.ts",
      "import": "./src/runtime-plugin.ts",
      "default": "./src/runtime-plugin.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "README-zh-CN.md",
    "src/**/!(*.test.*)"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "kawapress": "workspace:^"
  },
  "dependencies": {
    "@mdit/plugin-alert": "catalog:markdown"
  },
  "devDependencies": {
    "markdown-exit": "catalog:markdown"
  }
}
