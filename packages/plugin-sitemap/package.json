{
  "name": "@kawapress/plugin-sitemap",
  "type": "module",
  "version": "0.2.2",
  "description": "sitemap.xml output for KawaPress",
  "license": "MIT",
  "homepage": "https://kawapress.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kawapress/kawapress.git",
    "directory": "packages/plugin-sitemap"
  },
  "bugs": {
    "url": "https://github.com/kawapress/kawapress/issues"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "README-zh-CN.md",
    "src/**/!(*.test.*)"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "kawapress": "workspace:^"
  },
  "dependencies": {
    "consola": "catalog:node",
    "sitemap": "catalog:node"
  },
  "devDependencies": {
    "kawapress": "workspace:*",
    "typescript": "catalog:dev",
    "vite": "catalog:node"
  }
}
