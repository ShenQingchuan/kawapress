{
  "name": "@kawapress/plugin-shiki",
  "type": "module",
  "version": "0.0.0",
  "description": "Shiki and Twoslash plugin for KawaPress",
  "license": "MIT",
  "homepage": "https://shenqingchuan.github.io/kawapress/",
  "repository": {
