{
  "name": "@kawapress/plugin-search",
  "type": "module",
  "version": "0.2.2",
  "description": "Lazy local full-text search plugin for KawaPress",
  "license": "MIT",
  "homepage": "https://kawapress.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kawapress/kawapress.git",
    "directory": "packages/plugin-search"
  },
  "bugs": {
    "url": "https://github.com/kawapress/kawapress/issues"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./runtime-plugin": {
      "types": "./src/runtime-plugin.ts",
      "import": "./src/runtime-plugin.ts",
      "default": "./src/runtime-plugin.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "README-zh-CN.md",
    "src/**/!(*.test.*)"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "kawapress": "workspace:^",
    "vue": "catalog:frontend"
  },
  "dependencies": {
    "@mdit-vue/plugin-frontmatter": "catalog:markdown",
    "@mdit/plugin-alert": "catalog:markdown",
    "@mdit/plugin-attrs": "catalog:markdown",
    "@mdit/plugin-container": "catalog:markdown",
    "@unhead/vue": "catalog:frontend",
    "markdown-exit": "catalog:markdown",
    "markdown-it-anchor": "catalog:markdown",
    "minisearch": "catalog:frontend"
  },
  "devDependencies": {
    "kawapress": "workspace:*",
    "typescript": "catalog:dev",
    "vite": "catalog:node",
    "vue": "catalog:frontend"
  }
}
