    "markdown-exit": "catalog:markdown",
    "markdown-it-anchor": "catalog:markdown",
    "minisearch": "catalog:frontend"
  },
  "devDependencies": {
    "kawapress": "workspace:*",
    "typescript": "catalog:dev",
    "vite": "catalog:node",
    "vue": "catalog:frontend"
  }
