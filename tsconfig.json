{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // `bench` runs on Node's type stripping, which needs explicit `.ts` import specifiers.
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": [
    "eslint.config.ts",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.vue",
    "packages/*/src/**/*.d.ts",
    "packages/*/*.ts",
    "packages/*/*.config.ts",
    "e2e/**/*.ts",
    "bench/src/**/*.ts",
    "bench/src/**/*.d.ts"
  ]
}
